{
  "name": "anpio-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ANPIO 内嵌智能体执行引擎：supervisor、一次性会话、模型适配器与沙箱",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "runtime": "node --disable-warning=ExperimentalWarning src/supervisor.ts",
    "worker": "node --disable-warning=ExperimentalWarning src/agent-worker.ts",
    "session": "node --disable-warning=ExperimentalWarning src/session.ts",
    "standalone": "node --disable-warning=ExperimentalWarning src/standalone.ts",
    "router": "node --disable-warning=ExperimentalWarning src/router/main.ts",
    "anp:send": "node --disable-warning=ExperimentalWarning src/anp/send-cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "agents": "node --disable-warning=ExperimentalWarning --use-system-ca src/chat/cli.ts"
  },
  "dependencies": {
    "@anpio-cli/core": "file:../anpio-cli/packages/core",
    "@anpio-cli/service": "file:../anpio-cli/packages/service"
  },
  "overrides": {
    "@anpio-cli/core": "file:../anpio-cli/packages/core"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  },
  "bin": {
    "anpio-agents": "bin/anpio-agents.mjs"
  }
}
