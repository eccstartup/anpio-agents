{
  "name": "anpio-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ANPIO 内嵌智能体执行引擎：supervisor、一次性会话、模型适配器与沙箱",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
